{
  "appId": "com.kitapdas.app",
  "appName": "Kitapdaş",
  "webDir": "www",
  "backgroundColor": "#F7F1E6",
  "android": {
    "backgroundColor": "#F7F1E6"
  },
  "ios": {
    "backgroundColor": "#F7F1E6",
    "contentInset": "never"
  },
  "plugins": {
    "StatusBar": {
      "style": "LIGHT",
      "overlaysWebView": true
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    }
  }
}
